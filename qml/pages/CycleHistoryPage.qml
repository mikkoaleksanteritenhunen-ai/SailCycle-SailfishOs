import QtQuick 2.0
import Sailfish.Silica 1.0
import "../js/Database.js" as DB
Page{id:page;ListModel{id:m}function load(){m.clear();var a=DB.records();for(var i=a.length-1;i>=0;i--)m.append({rid:a[i].id,date:a[i].recordDate,type:a[i].recordType,flow:a[i].flow,obs:a[i].observations})}Component.onCompleted:load();onStatusChanged:if(status===PageStatus.Active)load();SilicaListView{anchors.fill:parent;model:m;header:PageHeader{title:qsTr("Cycle history");description:qsTr("%1 records").arg(m.count)}delegate:ListItem{id:item;contentHeight:Theme.itemSizeLarge;Column{anchors.left:parent.left;anchors.leftMargin:Theme.horizontalPageMargin;anchors.verticalCenter:parent.verticalCenter;Label{text:DB.parseDate(date).toLocaleDateString(Qt.locale(),Locale.LongFormat);color:Theme.primaryColor}Label{text:type+(flow!=="none"?" | "+flow:"");color:Theme.secondaryColor}}onClicked:pageStack.push(Qt.resolvedUrl("AddRecordPage.qml"),{initialDate:DB.parseDate(date)});menu:ContextMenu{MenuItem{text:qsTr("Delete");onClicked:item.remorseAction(qsTr("Deleting record"),function(){DB.deleteRecord(rid);load()})}}}ViewPlaceholder{enabled:m.count===0;text:qsTr("No records yet")}}}
